load("@build_bazel_rules_apple//apple:apple.bzl", "apple_universal_binary")

package(default_visibility = ["//visibility:private"])

config_setting(
    name = "macos_with_runtime",
    constraint_values = [
        "@platforms//os:macos",
    ],
    define_values = {
        "macos_zenz_runtime": "1",
    },
)

# mozc_zenz_guard always launches the worker with the dual-liveness switch, so
# a llama-server staged before that patch exits immediately and the scorer can
# never start. Fail the package build instead of shipping such a stale runtime.
genrule(
    name = "llama_server_checked",
    srcs = ["llama-server"],
    outs = ["checked/llama-server"],
    cmd = " ".join([
        "if ! /usr/bin/grep -a -q -F -- '--mozkey-zenz-dual-liveness-v1' $<;",
        "then echo 'ERROR: staged llama-server lacks the dual-liveness patch;'",
        "'rebuild it with build_universal_runtime.zsh and re-stage it' >&2;",
        "exit 1; fi;",
        "/bin/cp $< $@ && /bin/chmod 0755 $@",
    ]),
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

filegroup(
    name = "llama_server",
    srcs = select({
        ":macos_with_runtime": [":llama_server_checked"],
        "//conditions:default": [],
    }),
    target_compatible_with = [
        "@platforms//os:macos",
    ],
    visibility = ["//mac:__pkg__"],
)

filegroup(
    name = "model",
    srcs = select({
        ":macos_with_runtime": ["models/zenz-v3.2-small-Q5_K_M.gguf"],
        "//conditions:default": [],
    }),
    target_compatible_with = [
        "@platforms//os:macos",
    ],
    visibility = ["//mac:__pkg__"],
)

filegroup(
    name = "build_contract",
    srcs = select({
        ":macos_with_runtime": ["BUILD-CONTRACT.txt"],
        "//conditions:default": [],
    }),
    target_compatible_with = [
        "@platforms//os:macos",
    ],
    visibility = ["//mac:__pkg__"],
)

# Keep the cross-platform scorer target itself architecture-agnostic. The
# macOS packaging layer is responsible for producing one same-path Universal
# executable for the final app bundle.
apple_universal_binary(
    name = "mozc_zenz_guard_macos_universal",
    binary = "//zenz_scorer:mozc_zenz_guard",
    forced_cpus = [
        "x86_64",
        "arm64",
    ],
    minimum_deployment_os_version = "12.0",
    minimum_os_version = "12.0",
    platform_type = "macos",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

genrule(
    name = "mozc_zenz_guard_runtime",
    srcs = [":mozc_zenz_guard_macos_universal"],
    outs = ["mozc_zenz_guard"],
    cmd = "/bin/cp $< $@ && /bin/chmod 0755 $@",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//mac:__pkg__"],
)

apple_universal_binary(
    name = "mozc_zenz_scorer_macos_universal",
    binary = "//zenz_scorer:mozc_zenz_scorer",
    forced_cpus = [
        "x86_64",
        "arm64",
    ],
    minimum_deployment_os_version = "12.0",
    minimum_os_version = "12.0",
    platform_type = "macos",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

genrule(
    name = "mozc_zenz_scorer_runtime",
    srcs = [":mozc_zenz_scorer_macos_universal"],
    outs = ["mozc_zenz_scorer"],
    cmd = "/bin/cp $< $@ && /bin/chmod 0755 $@",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//mac:__pkg__"],
)

filegroup(
    name = "apache_license",
    srcs = ["licenses/Apache-2.0.txt"],
    visibility = ["//mac:__pkg__"],
)

filegroup(
    name = "llama_cpp_license",
    srcs = ["licenses/llama.cpp-MIT.txt"],
    visibility = ["//mac:__pkg__"],
)

filegroup(
    name = "third_party_notices",
    srcs = ["licenses/THIRD_PARTY_NOTICES.md"],
    visibility = ["//mac:__pkg__"],
)

filegroup(
    name = "zenz_model_notice",
    srcs = ["licenses/zenz-v3.2-small-gguf.txt"],
    visibility = ["//mac:__pkg__"],
)
